---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getAllCategories, toTermSlug } from '../../lib/posts';

const posts = await getAllPosts();
const categories = await getAllCategories();
const filterCategories = categories.filter(c => !['技术笔记', '随笔杂谈'].includes(c.name)).slice(0, 10);
---

<BaseLayout
  title="技术博客：游戏客户端架构、Unity、C++ 与图形学 | VVVVVenxo 的博客"
  description={`阅读 VVVVVenxo 的 ${posts.length} 篇技术文章，涵盖 Unity 引擎与渲染优化、C++ / C# 底层机制、计算机基础与 AI 工程实践。`}
  activeNav="blog"
>
  <div class="container py-12 md:py-16">
    <header class="page-heading">
      <p class="section-kicker">全部文章</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-[var(--text-primary)] md:text-5xl">
        博客
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-8 text-[var(--text-secondary)]">
        共 {posts.length} 篇文章，按发布时间倒序整理。
      </p>

      <div class="blog-filter-bar">
        <div class="flex flex-wrap gap-2">
          <a href="/blog" class="tag tag-active">全部 ({posts.length})</a>
          {
            filterCategories.map(cat => (
              <a href={`/categories/${encodeURIComponent(cat.slug)}/`} class="tag">
                {cat.name} ({cat.count})
              </a>
            ))
          }
        </div>

        <div class="blog-filter-input-wrap">
          <svg class="blog-filter-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            id="blog-instant-filter"
            type="search"
            class="blog-filter-input"
            placeholder="本页快速过滤标题 / 标签…"
            autocomplete="off"
          />
        </div>
      </div>
    </header>

    <div id="blog-post-list" class="post-list">
      {
        posts.map(post => (
          <article
            class="post-entry"
            data-filter-text={`${post.cleanTitle} ${post.categoryBadge} ${post.tags.join(' ')} ${post.description}`.toLowerCase()}
          >
            <div class="post-entry-meta">
              <time datetime={post.dateStr}>{post.dateFormatted}</time>
              <span>{post.readingMinutes} 分钟阅读</span>
              <span class="text-[var(--accent)]">{post.categoryBadge}</span>
            </div>
            <div>
              <h2 lang="zh-CN">
                <a href={post.url}>{post.cleanTitle}</a>
              </h2>
              <p class="post-entry-description" lang="zh-CN">
                {post.description}
              </p>
              {post.tags.length > 0 && (
                <div class="post-entry-tags">
                  {post.tags.map(tag => (
                    <a href={`/tags/${encodeURIComponent(toTermSlug(tag))}/`}># {tag}</a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
    <p id="blog-filter-empty" class="hidden py-12 text-center text-sm text-[var(--text-tertiary)]">
      没有找到匹配当前筛选词的文章。
    </p>
  </div>

  <script is:inline>
    (function () {
      const input = document.getElementById('blog-instant-filter');
      const items = document.querySelectorAll('#blog-post-list .post-entry');
      const emptyNote = document.getElementById('blog-filter-empty');
      if (!input || !items.length) return;

      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        let visibleCount = 0;
        items.forEach(el => {
          const text = el.getAttribute('data-filter-text') || '';
          const match = !q || text.includes(q);
          el.style.display = match ? '' : 'none';
          if (match) visibleCount++;
        });
        if (emptyNote) {
          emptyNote.classList.toggle('hidden', visibleCount > 0);
        }
      });
    })();
  </script>
</BaseLayout>
