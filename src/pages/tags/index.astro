---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../lib/posts';

const tags = await getAllTags();
---

<BaseLayout
  title="标签索引 | VVVVVenxo 的博客"
  description={`按技术标签浏览全部 ${tags.length} 个主题标签。`}
  activeNav="tags"
>
  <div class="container py-12 md:py-16">
    <header class="page-heading">
      <p class="section-kicker">主题索引</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-[var(--text-primary)] md:text-5xl">
        标签
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-8 text-[var(--text-secondary)]">
        共 {tags.length} 个细分技术标签，按收录文章数量排序。
      </p>
    </header>

    <div class="topic-index">
      {
        tags.map(tag => (
          <a href={`/tags/${encodeURIComponent(tag.slug)}/`}>
            <span lang="zh-CN"># {tag.name}</span>
            <span class="topic-index-count">{tag.count} 篇</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
