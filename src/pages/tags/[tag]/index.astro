---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllTags, toTermSlug, type PostItem } from '../../../lib/posts';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map(tag => ({
    params: { tag: tag.slug },
    props: { name: tag.name, slug: tag.slug, posts: tag.posts },
  }));
}

interface Props {
  name: string;
  posts: PostItem[];
}

const { name, posts } = Astro.props;
---

<BaseLayout
  title={`#${name} | VVVVVenxo 的博客`}
  description={`浏览包含标签「#${name}」的 ${posts.length} 篇技术文章。`}
  activeNav="tags"
>
  <div class="container py-12 md:py-16">
    <header class="page-heading">
      <p class="section-kicker">标签筛选</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-[var(--text-primary)] md:text-5xl">
        # {name}
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-8 text-[var(--text-secondary)]">
        共 {posts.length} 篇相关文章，按发布时间倒序排列。
      </p>
      <div class="mt-5">
        <a href="/tags" class="home-text-link">← 返回全部标签</a>
      </div>
    </header>

    <div class="post-list">
      {
        posts.map(post => (
          <article class="post-entry">
            <div class="post-entry-meta">
              <time datetime={post.dateStr}>{post.dateFormatted}</time>
              <span>{post.readingMinutes} 分钟阅读</span>
              <span>{post.categoryBadge}</span>
            </div>
            <div>
              <h2 lang="zh-CN">
                <a href={post.url}>{post.title}</a>
              </h2>
              <p class="post-entry-description" lang="zh-CN">
                {post.description}
              </p>
              {post.tags.length > 0 && (
                <div class="post-entry-tags">
                  {post.tags.map(tag => (
                    <a
                      href={`/tags/${encodeURIComponent(toTermSlug(tag))}/`}
                      class={tag === name ? 'font-semibold text-[var(--accent)]' : ''}
                    >
                      # {tag}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
