---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, toTermSlug } from '../../lib/posts';

const posts = await getAllPosts();
---

<BaseLayout
  title="文章归档 | VVVVVenxo 的博客"
  description={`按时间归档的全部 ${posts.length} 篇技术文章。`}
  activeNav="blog"
>
  <div class="container py-12 md:py-16">
    <header class="page-heading">
      <p class="section-kicker">时间轴归档</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-[var(--text-primary)] md:text-5xl">
        全部归档
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-8 text-[var(--text-secondary)]">
        共 {posts.length} 篇文章，按发布时间倒序排列。
      </p>
    </header>

    <div class="post-list">
      {
        posts.map(post => (
          <article class="post-entry">
            <div class="post-entry-meta">
              <time datetime={post.dateStr}>{post.dateFormatted}</time>
              <span>{post.readingMinutes} 分钟阅读</span>
              <span>{post.categoryBadge}</span>
            </div>
            <div>
              <h2 lang="zh-CN">
                <a href={post.url}>{post.title}</a>
              </h2>
              <p class="post-entry-description" lang="zh-CN">
                {post.description}
              </p>
              {post.tags.length > 0 && (
                <div class="post-entry-tags">
                  {post.tags.map(tag => (
                    <a href={`/tags/${encodeURIComponent(toTermSlug(tag))}/`}># {tag}</a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
