---
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderMarkdown, getAllPosts } from '../../lib/posts';

const aboutFile = path.resolve(process.cwd(), 'source/about/index.md');
const rawAbout = fs.readFileSync(aboutFile, 'utf8');
const { content } = matter(rawAbout);
const { html } = await renderMarkdown(content);
const posts = await getAllPosts();
---

<BaseLayout
  title="知识图谱与关于 | VVVVVenxo 的博客"
  description="游戏客户端开发、Unity、C++/C#、图形学与计算机基础的知识图谱与阅读路线。"
  activeNav="about"
>
  <div class="container py-12 md:py-16">
    <header class="page-heading">
      <p class="section-kicker">KNOWLEDGE MAP &amp; ABOUT</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-[var(--text-primary)] md:text-5xl">
        知识图谱
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-8 text-[var(--text-secondary)]">
        全站目前已收录 {posts.length} 篇体系化技术手记，按四大核心方向整理。
      </p>
    </header>

    <div class="prose max-w-none" lang="zh-CN" set:html={html} />
  </div>
</BaseLayout>
