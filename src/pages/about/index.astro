---
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderMarkdown, getAllPosts } from '../../lib/posts';

const aboutFile = path.resolve(process.cwd(), 'source/about/index.md');
const rawAbout = fs.readFileSync(aboutFile, 'utf8');
const { content } = matter(rawAbout);
const { html } = await renderMarkdown(content);
const posts = await getAllPosts();
---

<BaseLayout
  title="关于与知识图谱 | VVVVVenxo 的博客"
  description="关于 VVVVVenxo 以及游戏客户端开发、Unity、C++/C#、图形学与计算机基础的知识图谱。"
  activeNav="about"
>
  <div class="container py-12 md:py-16">
    <div class="about-intro">
      <img src="/img/Avatar.jpg" alt="VVVVVenxo" width="88" height="88" />
      <div>
        <p class="section-kicker">ABOUT &amp; KNOWLEDGE MAP</p>
        <h1 class="mt-2 font-serif text-3xl font-semibold text-[var(--text-primary)] md:text-4xl">
          VVVVVenxo
        </h1>
        <p class="mt-2 text-sm text-[var(--text-secondary)]">
          游戏客户端开发工程师 · 已收录 {posts.length} 篇体系化技术手记
        </p>
      </div>
    </div>

    <div class="prose max-w-none" lang="zh-CN" set:html={html} />
  </div>
</BaseLayout>
